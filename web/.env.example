# ==============================================================================
# FoodSense — Variables de Entorno (.env.local / Vercel Environment Variables)
# ==============================================================================

# --- Firebase Client SDK (Proyecto: foodsense-revive) ---
# Obtené estos valores en: Firebase Console > Project Settings > General > Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=foodsense-revive.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=foodsense-revive
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=foodsense-revive.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=392452066897
NEXT_PUBLIC_FIREBASE_APP_ID=1:392452066897:web:d82ad5a7138f3e926b7270

# --- Web Push / Cloud Messaging (FCM VAPID Key) ---
# Obtené este valor en: Firebase Console > Project Settings > Cloud Messaging > Web configuration > Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...

# --- Supabase (Base de Datos PostgreSQL) ---
# Obtené estos valores en: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Google Gemini AI (Backend / Server-side) ---
# Obtené tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
